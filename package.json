  "homepage": "https://doramirdor.github.io/echo/",
  "repository": {
    "type": "git",
    "url": "https://github.com/doramirdor/echo.git"
  },
  "bugs": {
    "url": "https://github.com/doramirdor/echo/issues"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.3"
  }
